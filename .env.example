# Copy to backend/.env for local (non-Docker) development, or use as the
# basis for docker-compose environment values.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://universum:universum@localhost:5432/moodle_universum"

# --- Moodle integration ---------------------------------------------------
# "mock" (default) uses MockMoodleProvider with realistic fake data and
# requires no real Moodle server. Switch to "real" to talk to an actual
# Moodle instance via its REST Web Services.
MOODLE_PROVIDER=mock

# Only required when MOODLE_PROVIDER=real.
# Base URL of your Moodle site, no trailing slash.
MOODLE_BASE_URL=https://moodle.example.org
# A Web Services token for a user/service with permission to call:
#   core_webservice_get_site_info
#   core_enrol_get_users_courses
#   core_course_get_categories
# Generate under Site administration > Server > Web services > Manage tokens.
MOODLE_TOKEN=
MOODLE_TIMEOUT_MS=10000

# --- Auth ------------------------------------------------------------------
# Only "dev" is implemented today. Architected so a Moodle SSO / OAuth
# provider can be added later without touching routes (see backend/src/auth).
AUTH_MODE=dev
# Default role assigned to the dev user on first run: "student" or "admin".
# Override per-request in development with the `x-dev-role` header.
DEV_DEFAULT_ROLE=student

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
# Used to build "Open in Moodle" links; should match MOODLE_BASE_URL in prod.
VITE_MOODLE_BASE_URL=https://moodle.example.org
